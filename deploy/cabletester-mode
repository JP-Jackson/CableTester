#!/usr/bin/env bash
# Switch what the attached panel shows, and remember the choice across reboots.
#
#   cabletester-mode kiosk    lock the panel to the tester, full screen
#   cabletester-mode desk     drop to the normal desktop (for working on it)
#   cabletester-mode status   what is running right now
#   cabletester-mode restart  reload the kiosk, after editing the UI
#   cabletester-mode url URL  point the kiosk elsewhere ( --reset to undo )
#   cabletester-mode logs     follow the kiosk's output
#   cabletester-mode boot     internal: run from ~/.config/autostart
#
# What this does NOT touch: the tester server itself. cabletester.service runs
# in both modes and keeps serving the network. Dropping to the desktop does not
# stop a sweep in progress, and it never makes the instrument unreachable from
# a laptop or a phone. The mode is only about this panel.
#
# SSH is likewise unaffected and always available. "Kiosk for techs, WiFi for
# me" is not two modes: it is the kiosk on the panel and SSH over the network,
# at the same time. Use 'desk' only when you want the actual desktop on the
# 7 inch screen in front of you.

set -euo pipefail

UNIT="cabletester-kiosk.service"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cabletester"
MODE_FILE="$STATE_DIR/mode"

mkdir -p "$STATE_DIR"

# A user unit started from a login shell or over SSH has no idea which display
# to draw on. Hand it the session's variables before starting it, or Chromium
# exits immediately with a "cannot open display" that reads like a crash loop.
import_session_env() {
  systemctl --user import-environment \
    DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_SESSION_TYPE \
    2>/dev/null || true

  # import-environment copies from THIS shell, and an SSH shell has no
  # WAYLAND_DISPLAY to copy. So over SSH the import succeeded and imported
  # nothing, Chromium started with no display, and it read as the kiosk being
  # broken rather than as the command being run from the wrong place.
  #
  # The compositor's socket is on disk, so find it rather than depending on an
  # environment that only exists inside the graphical session.
  if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    _rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    _sock="$(find "$_rt" -maxdepth 1 -name 'wayland-*' ! -name '*.lock' -printf '%f\n' 2>/dev/null | head -1)"
    if [ -n "$_sock" ]; then
      systemctl --user set-environment "WAYLAND_DISPLAY=$_sock" "XDG_RUNTIME_DIR=$_rt" 2>/dev/null || true
    fi
  fi
}

current_mode() {
  [ -f "$MODE_FILE" ] && cat "$MODE_FILE" || echo kiosk
}

# How long the box actually took to put the tester on the panel.
#
# "It takes a while to come up" is not something anyone can act on, and the
# time is split across three things that fail differently: firmware and kernel,
# the server starting, and the kiosk waiting for the server before it opens a
# window. Reported separately so the next person can see WHICH of those is slow
# rather than rebooting and counting out loud.
boot_report() {
  command -v systemd-analyze >/dev/null 2>&1 || return 0

  # Seconds since the epoch that the kernel handed over, from the monotonic
  # clock rather than from parsed prose: systemd-analyze's wording has changed
  # between releases and scraping it is how this quietly stops working.
  local now_mono boot_epoch
  now_mono=$(awk '{print $1; exit}' /proc/uptime 2>/dev/null) || return 0
  boot_epoch=$(awk -v u="$now_mono" 'BEGIN { printf "%d", systime() - u }')

  # Captured rather than piped straight to the terminal: systemd-analyze
  # succeeds with NO output when there is no running systemd to ask, which
  # printed a label with no value and no newline, and the next line ran into
  # the end of this one.
  local summary
  summary=$(systemd-analyze time 2>/dev/null | head -1)
  printf 'boot:           %s\n' "${summary:-unknown}"

  _since_boot() {
    # ActiveEnterTimestamp is empty for a unit that never came up, which is a
    # finding rather than a zero.
    local stamp
    stamp=$(printf '%s' "$1" | sed 's/^[A-Za-z]* //')
    [ -n "$stamp" ] || { echo "not started"; return; }
    local at
    at=$(date -d "$stamp" +%s 2>/dev/null) || { echo unknown; return; }
    echo "$((at - boot_epoch))s after power on"
  }

  printf 'server up:      %s\n' \
    "$(_since_boot "$(systemctl show cabletester.service \
        -p ActiveEnterTimestamp --value 2>/dev/null)")"
  printf 'panel up:       %s\n' \
    "$(_since_boot "$(systemctl --user show "$UNIT" \
        -p ActiveEnterTimestamp --value 2>/dev/null)")"
}

case "${1:-status}" in
  kiosk)
    echo kiosk > "$MODE_FILE"
    import_session_env
    systemctl --user start "$UNIT"
    echo "cabletester-mode: kiosk. The panel is locked to the tester."
    ;;

  desk)
    echo desk > "$MODE_FILE"
    systemctl --user stop "$UNIT" || true
    echo "cabletester-mode: desktop. The tester is still running at http://localhost:5000/"
    echo "Run 'cabletester-mode kiosk' when you are done, or just reboot."
    ;;

  boot)
    # Started by ~/.config/autostart/cabletester-kiosk.desktop once the
    # graphical session exists. The flag file is the whole reason this
    # indirection exists: it makes 'desk' survive a power cycle.
    if [ "$(current_mode)" = "desk" ]; then
      echo "cabletester-mode: desktop mode set, not starting the kiosk."
      exit 0
    fi
    import_session_env
    systemctl --user start "$UNIT"
    ;;

  restart)
    import_session_env
    systemctl --user restart "$UNIT"
    echo "cabletester-mode: kiosk restarted."
    ;;

  url)
    # Point the kiosk somewhere other than the tester. Written to a file
    # rather than the environment because a shell variable cannot reach a
    # service systemd starts, so `CABLETESTER_URL=... cabletester-mode restart`
    # silently does nothing and looks like the override being ignored.
    URL_FILE="$STATE_DIR/url"
    case "${2:-}" in
      "")
        echo "kiosk url: $([ -s "$URL_FILE" ] && cat "$URL_FILE" || echo 'http://localhost:5000/ (default)')"
        echo "usage: cabletester-mode url <URL> | --reset"
        exit 0
        ;;
      --reset)
        rm -f "$URL_FILE"
        echo "cabletester-mode: kiosk URL reset to the tester."
        ;;
      *)
        printf '%s' "$2" > "$URL_FILE"
        echo "cabletester-mode: kiosk URL set to $2"
        ;;
    esac
    import_session_env
    systemctl --user restart "$UNIT" 2>/dev/null || true
    ;;

  status)
    echo "saved mode:     $(current_mode)"
    printf 'kiosk:          '
    systemctl --user is-active "$UNIT" 2>/dev/null || true
    printf 'tester server:  '
    systemctl is-active cabletester.service 2>/dev/null || true
    printf 'serial ports:   '
    # Worth showing here: a missing adapter is the most common "it is broken"
    # report, and it looks identical to a software fault from the panel.
    ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ' ' || echo -n 'none'
    echo
    # Undervoltage deserves to be on the same screen as the port list. A Pi
    # browning out under load produces serial timing errors that look, on the
    # panel, exactly like a marginal cable. If a known-good cable starts
    # failing high baud rates, read this line before suspecting the cable.
    if command -v vcgencmd >/dev/null 2>&1; then
      t="$(vcgencmd get_throttled 2>/dev/null || echo 'throttled=unknown')"
      printf 'power:          %s' "$t"
      case "$t" in
        throttled=0x0|throttled=unknown) echo ;;
        *) echo "  <-- undervoltage or throttling recorded, check the supply" ;;
      esac
    fi
    boot_report
    ;;

  logs)
    journalctl --user -u "$UNIT" -f
    ;;

  *)
    echo "usage: cabletester-mode {kiosk|desk|status|restart|logs|url}" >&2
    exit 2
    ;;
esac
