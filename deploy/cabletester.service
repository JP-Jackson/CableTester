# systemd unit for the RS-232 cable tester server.
#
# This is a template. deploy/setup-pi.sh substitutes __CT_USER__, __CT_HOME__
# and __CT_DIR__ and installs the result, which is the supported path:
#
#   ./deploy/setup-pi.sh
#
# To install by hand instead, replace the three placeholders yourself:
#   sed -e "s|__CT_USER__|$USER|g" -e "s|__CT_HOME__|$HOME|g" \
#       -e "s|__CT_DIR__|$PWD|g" deploy/cabletester.service \
#     | sudo tee /etc/systemd/system/cabletester.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cabletester
#
# The service user must be in the 'dialout' group to open serial ports:
#   sudo usermod -aG dialout __CT_USER__
#
# This unit runs in both kiosk and desktop mode. It is the instrument; the
# kiosk is only how the instrument is displayed. Stopping the kiosk never
# stops a test in progress.

[Unit]
Description=RS-232 Cable Tester web interface
Documentation=file:__CT_DIR__/README.md
# NOT network-online.target, deliberately. This box has no network at the
# bench by design, and network-online is satisfied by NetworkManager-wait-online,
# which BLOCKS until it gets a connection or times out. On a bench kit that
# never gets one, that is a fixed delay on every single boot before the server
# even begins to start, and the kiosk sits waiting on a server that has not
# been allowed to run yet. It reads as the instrument being slow to come up.
#
# The tester binds to localhost and serves the panel attached to the same box.
# It needs the network stack to exist, not to be connected to anything.
After=network.target

[Service]
Type=simple
User=__CT_USER__
Group=dialout
WorkingDirectory=__CT_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=CABLETESTER_PROFILES=__CT_DIR__/profiles.json
ExecStart=__CT_DIR__/.venv/bin/python run.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=5

# Reconfiguring a network interface needs CAP_NET_ADMIN. Granted as an ambient
# capability rather than by running as root or by a sudo rule: the service
# keeps its unprivileged user and gets exactly the one privilege the ethernet
# ladder requires, which is changing what an interface advertises.
#
# ethernet_tests refuses to touch an interface carrying the default route, so
# this cannot be used to knock the box off its own network.
# NET_ADMIN changes what an interface advertises, for the speed ladder.
# NET_RAW opens the AF_PACKET socket the load test sends frames on. Two
# interfaces on one host cannot be talked between over IP (the kernel sees both
# as local and short-circuits through loopback, never touching the cable), so
# the load test works at layer 2 where the routing table does not apply.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

# The tester only needs its own directory writable (for profiles.json).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__CT_DIR__

[Install]
WantedBy=multi-user.target
